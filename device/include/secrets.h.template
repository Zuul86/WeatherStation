#ifndef SECRETS_H
#define SECRETS_H

// Wi-Fi Configuration (Fallback if WiFiManager is not used)
#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Sensor Settings
#define DHT_PIN 14            // Pin connected to DHT22 data line
#define SDA_PIN 4             // I2C SDA Pin (for BMP180)
#define SCL_PIN 5             // I2C SCL Pin (for BMP180)
#define ALTITUDE_METERS 100.0 // Your local altitude in meters for pressure calculation
#define LAT 37.7749           // Station Latitude
#define LONG -122.4194        // Station Longitude
#define DATA_COLLECTION_INTERVAL 60000 // Ingestion interval (milliseconds)

// Azure IoT Hub / MQTT Configuration
// For Azure IoT Hub:
//   MQTT_SERVER: "<hub-name>.azure-devices.net"
//   MQTT_PORT: 8883
//   MQTT_CLIENT_ID: "<device-id>"
//   MQTT_USER: "<hub-name>.azure-devices.net/<device-id>/?api-version=2021-04-12"
//   MQTT_PASSWORD: "SharedAccessSignature sr=<hub-name>.azure-devices.net%2Fdevices%2F<device-id>&sig=...&se=..."
//   MQTT_TELEMETRY_TOPIC: "devices/<device-id>/messages/events/"
//
// For Local Mosquitto:
//   MQTT_SERVER: "192.168.1.X"
//   MQTT_PORT: 1883
//   MQTT_CLIENT_ID: "WeatherStationESP8266"
//   MQTT_USER: "dev_user"
//   MQTT_PASSWORD: "dev_password"
//   MQTT_TELEMETRY_TOPIC: "weather/telemetry"

#define MQTT_SERVER "YOUR_IOTHUB_NAME.azure-devices.net"
#define MQTT_PORT 8883
#define MQTT_CLIENT_ID "YOUR_DEVICE_ID"
#define MQTT_USER "YOUR_IOTHUB_NAME.azure-devices.net/YOUR_DEVICE_ID/?api-version=2021-04-12"
#define MQTT_PASSWORD "SharedAccessSignature sr=..."
#define MQTT_TELEMETRY_TOPIC "devices/YOUR_DEVICE_ID/messages/events/"

// SSL/TLS Configuration (optional)
// The SSL certificate fingerprint of the MQTT broker if pinning is desired
// #define MQTT_SSL_FINGERPRINT "XX XX XX XX XX XX XX XX XX XX XX XX XX XX XX XX XX XX XX XX"

#endif

